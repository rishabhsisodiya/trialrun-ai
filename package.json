{
  "name": "trialrun-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local mock interviews that run on the coding agent plan you already have.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rishabhsisodiya/trialrun-ai.git"
  },
  "homepage": "https://github.com/rishabhsisodiya/trialrun-ai#readme",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && tsx server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"server/test/*.test.ts\"",
    "test:live": "node --import tsx --test \"server/test/live/*.live.ts\""
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@fastify/static": "^10.1.6",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@phosphor-icons/react": "^2.1.0",
    "codemirror": "^6.0.2",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
